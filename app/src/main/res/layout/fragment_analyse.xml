<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Lungs Image Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#457B9D"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/ivLungs"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/lungs"
                android:contentDescription="@string/lungsIcon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/uploadXRayCt"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pleaseUploadAClearMedicalImageForAnalysis"
                android:textColor="#E0F0FF"
                android:textSize="14sp"
                android:textAlignment="center"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Image preview -->
        <ImageView
            android:id="@+id/selectedImageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:background="@drawable/image_preview_border"
            android:contentDescription="@string/selected_image" />

        <!-- Camera Button -->
        <Button
            android:id="@+id/btnUseCamera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/useCamera"
            android:textColor="#457B9D"
            android:backgroundTint="#DCF7F5"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp"
            android:drawableStart="@drawable/camera"
            android:drawablePadding="8dp"/>

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/or"
            android:textColor="#888888"
            android:layout_marginVertical="8dp" />

        <!-- Gallery Selection -->
        <TextView
            android:id="@+id/tvSelectImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/selectImagesFromGalleryPngOnly"
            android:textColor="#344A48"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:background="@drawable/gallery_selector_background"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/linear"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <!-- Analysis Button -->
        <Button
            android:id="@+id/btnStartAnalysis"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/startAnalysis"
            android:textColor="#FFFFFF"
            android:backgroundTint="#457B9D"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
