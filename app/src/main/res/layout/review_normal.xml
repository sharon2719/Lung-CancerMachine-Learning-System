<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#EFEFEF">

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Icon -->
    <ImageView
        android:id="@+id/iv_stars"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/normal"
        android:contentDescription="@string/analysis_image"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submitted text -->
    <TextView
        android:id="@+id/tv_review_submitted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Image submitted successfully!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1D3557"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/iv_stars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Analysis result -->
    <TextView
        android:id="@+id/tv_analysis"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="The lung image shows no signs of Cancer."
        android:textColor="#4A4A4A"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tv_review_submitted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Confidence -->
    <TextView
        android:id="@+id/tv_confidence_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confidence: --%"
        android:textColor="#2A9D8F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_analysis"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Action Title -->
    <TextView
        android:id="@+id/tv_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recommended Action:"
        android:textColor="#1D3557"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_confidence_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Action Message -->
    <TextView
        android:id="@+id/tv_additional_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maintain a healthy lifestyle."
        android:textColor="#2A9D8F"
        android:textSize="16sp"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tv_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- Resources Section -->
    <LinearLayout
        android:id="@+id/ll_resources_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_additional_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Section Title -->
        <TextView
            android:id="@+id/tv_resources_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resources"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1D3557"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal" />

        <!-- Healthy Living -->
        <LinearLayout
            android:id="@+id/ll_resource_healthy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#F1FAEE"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/health"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_resource_healthy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Healthy Living Tips"
                android:textColor="#1D3557"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="8dp"/>

        <!-- Screening Guidelines -->
        <LinearLayout
            android:id="@+id/ll_resource_screening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#F1FAEE"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/screening"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_resource_screening"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lung Cancer Screening Guidelines"
                android:textColor="#1D3557"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
